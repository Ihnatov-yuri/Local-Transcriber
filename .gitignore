# Gradle
.gradle/
build/
!gradle-wrapper.jar

# IDE
.idea/
*.iml
local.properties
.DS_Store
captures/

# Kotlin incremental compilation cache
.kotlin/

# Claude Code project state (tooling, not source)
.claude/

# Android
*.apk
*.aab
*.ap_
*.dex
output.json

# Keystore / signing
*.jks
*.keystore
keystore.properties

# NDK / native build artifacts
.cxx/
app/src/main/jniLibs/**/*.so
app/src/main/cpp/whisper.cpp/
app/src/main/cpp/build/

# Downloaded models (provisioned at first run, never committed)
app/src/main/assets/models/
**/models/*.bin
**/models/*.gguf
**/models/*.litertlm
**/models/*.task
*.bin
*.gguf
*.litertlm

# ONNX models — broad rule excluded by default, except for our bundled
# segmentation model which is part of the app source. ONNX embedding models
# downloaded by the user still live under models/ and are caught above.
*.onnx
!app/src/main/assets/segmentation.onnx

# Logs
*.log
