<?xml version="1.0" encoding="utf-8"?>
<!-- Editorial brand mark: a bold ink "T" (transcriber) with the orange
     accent dot trailing it, mirroring the in-app "transcriber ●" wordmark.
     Ink = InkLight #16130F, accent = #FF4726. Glyph sits inside the
     center 66dp safe zone so the launcher mask never clips it. The
     monochrome themed-icon layer reuses this; the T+dot silhouette still
     reads when system-tinted to one colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- lowercase "t": crossbar + stem with a short foot, so it reads as
         a "t" rather than a "+". Stem extends well below the crossbar
         and kicks right at the foot. -->
    <!-- crossbar -->
    <path
        android:fillColor="#16130F"
        android:pathData="M34,40 h31 v10 h-31 z" />
    <!-- stem + foot (one shape) -->
    <path
        android:fillColor="#16130F"
        android:pathData="M44,28 h11 v40 c0,4 2.5,6.5 6.5,6.5 h4 v9 h-5 c-9,0 -16.5,-5 -16.5,-15.5 z" />
    <!-- orange accent dot, trailing to the lower-right -->
    <path
        android:fillColor="#FF4726"
        android:pathData="M74,72 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0 z" />
</vector>
