<?xml version="1.0" encoding="utf-8"?>
<!--
  Google Play Services Fonts provider certificates.
  Required by androidx.compose.ui.text.googlefonts.GoogleFont.Provider so it
  can verify the signing certificate of the on-device font provider before
  trusting it. Boilerplate per the official Compose Fonts docs
  (https://developer.android.com/develop/ui/compose/text/fonts#downloadable-fonts).
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item>
            
        </item>
    </string-array>
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item>
            
        </item>
    </string-array>
</resources>
